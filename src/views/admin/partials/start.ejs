<!doctype html>
<html lang="vi">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %></title>
  <link rel="stylesheet" href="/css/reset.css" />
  <link rel="stylesheet" href="/css/base.css" />
  <link rel="stylesheet" href="/css/admin.css" />
</head>
<body class="admin-page">
  <a class="admin-skip" href="#admin-content">Đến nội dung</a>
  <header class="admin-header">
    <a class="admin-brand" href="/admin">TechZone</a>
    <nav class="admin-nav" aria-label="Điều hướng quản trị">
      <% if (currentUser && currentUser.role === 'admin') { %>
        <a href="/admin" <%= typeof accountPath !== 'undefined' && accountPath === '/admin' ? 'aria-current=page' : '' %>>Tổng quan</a>
        <a href="/admin/categories" <%= typeof accountPath !== 'undefined' && (accountPath === '/admin/categories' || accountPath.startsWith('/admin/categories/')) ? 'aria-current=page' : '' %>>Danh mục</a>
        <a href="/admin/products" <%= typeof accountPath !== 'undefined' && (accountPath === '/admin/products' || accountPath.startsWith('/admin/products/')) ? 'aria-current=page' : '' %>>Sản phẩm</a>
        <a href="/admin/orders" <%= typeof accountPath !== 'undefined' && (accountPath === '/admin/orders' || accountPath.startsWith('/admin/orders/')) ? 'aria-current=page' : '' %>>Đơn hàng</a>
        <a href="/admin/coupons" <%= typeof accountPath !== 'undefined' && (accountPath === '/admin/coupons' || accountPath.startsWith('/admin/coupons/')) ? 'aria-current=page' : '' %>>Mã giảm giá</a>
        <a href="/admin/advertisements" <%= typeof accountPath !== 'undefined' && (accountPath === '/admin/advertisements' || accountPath.startsWith('/admin/advertisements/')) ? 'aria-current=page' : '' %>>Quảng cáo</a>
      <% } %>
      <a href="/">Xem cửa hàng</a>
      <% if (currentUser) { %>
        <form action="/logout" method="post">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
          <button class="btn btn--primary" type="submit">Đăng xuất</button>
        </form>
      <% } %>
    </nav>
  </header>
  <main class="admin-content" id="admin-content" tabindex="-1">
